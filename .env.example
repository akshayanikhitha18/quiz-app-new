# Copy this file to ".env" and fill in your own values. Never commit ".env".
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=quizsphere_user
DB_PASSWORD=
DB_NAME=quizsphere
DB_POOL_SIZE=8

SERVER_HOST=127.0.0.1
SERVER_PORT=8000

SESSION_HOURS=8
PBKDF2_ITERATIONS=600000
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
DEADLINE_GRACE_SECONDS=5
# Keep false on plain http://localhost. Set true only behind HTTPS.
COOKIE_SECURE=false
